FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04

WORKDIR /workspace

# ---- proxy (if needed) ----
ARG HTTP_PROXY
ARG HTTPS_PROXY

ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY
ENV http_proxy=$HTTP_PROXY
ENV https_proxy=$HTTPS_PROXY

# ---- system deps ----
RUN apt-get update && apt-get install -y \
    python3.9 python3.9-dev python3.9-distutils \
    python3-pip git curl wget build-essential \
 && rm -rf /var/lib/apt/lists/*

# ---- set python3.9 as default ----
RUN ln -sf /usr/bin/python3.9 /usr/bin/python
RUN ln -sf /usr/bin/python3.9 /usr/bin/python3

# ---- upgrade pip ----
RUN python -m pip install --upgrade pip

# ---- copy code ----
COPY nuplan-devkit/ /workspace/nuplan-devkit/
COPY Thesis/ /workspace/emoe/

# ---- install torch ----
RUN pip install torch==2.0.1 torchvision==0.15.2 \
    --index-url https://download.pytorch.org/whl/cu118

# ---- install natten (local wheel) ----
COPY natten*.whl /workspace/
RUN pip install /workspace/natten*.whl

# ---- install nuplan ----
RUN pip install -e /workspace/nuplan-devkit
RUN pip install -r /workspace/nuplan-devkit/requirements.txt

# ---- install your EMOE ----
RUN pip install -r /workspace/emoe/requirements.txt

# ---- entrypoint ----
COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

ENTRYPOINT ["/workspace/entrypoint.sh"]
