FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# ---- install Python (use system default = 3.10) ----
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    python3-distutils \
    git \
    curl \
    wget \
    build-essential \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# ---- set python default ----
RUN ln -sf /usr/bin/python3 /usr/bin/python

# ---- upgrade pip ----
RUN python -m pip install --upgrade pip setuptools wheel

# ---- install torch ----
RUN pip install torch==2.0.1 torchvision==0.15.2 \
    --index-url https://download.pytorch.org/whl/cu118

# ---- copy code ----
COPY nuplan-devkit/ /workspace/nuplan-devkit/
COPY Thesis/ /workspace/emoe/

# ---- natten ----
COPY natten*.whl /workspace/
RUN pip install /workspace/natten*.whl

# ---- install nuplan ----
RUN pip install -e /workspace/nuplan-devkit

# ⚠️ OPTIONAL: skip if conflicts
# RUN pip install -r /workspace/nuplan-devkit/requirements.txt

# ---- EMoE ----
RUN pip install -r /workspace/emoe/requirements.txt

# ---- entrypoint ----
COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

ENTRYPOINT ["/workspace/entrypoint.sh"]
