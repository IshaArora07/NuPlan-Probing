# Stage 1: get Python 3.9 from official image
FROM python:3.9-slim AS python-base

# Stage 2: final image
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# ---- copy Python 3.9 from official image ----
COPY --from=python-base /usr/local/lib/python3.9 /usr/local/lib/python3.9
COPY --from=python-base /usr/local/bin/python3.9 /usr/local/bin/python3.9
COPY --from=python-base /usr/local/bin/pip3.9 /usr/local/bin/pip3.9
COPY --from=python-base /usr/local/include/python3.9 /usr/local/include/python3.9
COPY --from=python-base /usr/local/lib/libpython3.9* /usr/local/lib/

# ---- basic system deps, all in default Ubuntu repos, no PPA needed ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    build-essential \
    ca-certificates \
    libexpat1 \
 && rm -rf /var/lib/apt/lists/*

# ---- set python3.9 as default ----
RUN ln -sf /usr/local/bin/python3.9 /usr/bin/python && \
    ln -sf /usr/local/bin/python3.9 /usr/bin/python3 && \
    ln -sf /usr/local/bin/pip3.9 /usr/bin/pip

# ---- upgrade pip ----
RUN python -m pip install --upgrade pip setuptools wheel

# ---- copy code ----
COPY nuplan-devkit/ /workspace/nuplan-devkit/
COPY Thesis/ /workspace/emoe/

# ---- install torch ----
RUN pip install torch==2.0.1 torchvision==0.15.2 \
    --index-url https://download.pytorch.org/whl/cu118

# ---- install natten (local wheel) ----
COPY natten*.whl /workspace/
RUN pip install /workspace/natten*.whl

# ---- install nuplan-devkit ----
RUN pip install -e /workspace/nuplan-devkit
RUN pip install -r /workspace/nuplan-devkit/requirements.txt

# ---- install EMoE ----
RUN pip install -r /workspace/emoe/requirements.txt

# ---- entrypoint ----
COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

ENTRYPOINT ["/workspace/entrypoint.sh"]
