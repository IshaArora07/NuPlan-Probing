FROM python:3.9-slim

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# ---- install CUDA dependencies manually instead of using nvidia base ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    build-essential \
    ca-certificates \
    libexpat1 \
    # CUDA runtime libs
    libcublas-11-8 \
    libcudnn8 \
    libcufft-11-8 \
    libcurand-11-8 \
    libcusolver-11-8 \
    libcusparse-11-8 \
 && rm -rf /var/lib/apt/lists/*

# ---- upgrade pip ----
RUN python -m pip install --upgrade pip setuptools wheel

# ---- copy code ----
COPY nuplan-devkit/ /workspace/nuplan-devkit/
COPY Thesis/ /workspace/emoe/

# ---- install torch (brings its own CUDA runtime, no system CUDA needed) ----
RUN pip install torch==2.0.1 torchvision==0.15.2 \
    --index-url https://download.pytorch.org/whl/cu118

# ---- install natten ----
COPY natten*.whl /workspace/
RUN pip install /workspace/natten*.whl

# ---- install nuplan-devkit ----
RUN pip install -e /workspace/nuplan-devkit
RUN pip install -r /workspace/nuplan-devkit/requirements.txt

# ---- install EMoE ----
RUN pip install -r /workspace/emoe/requirements.txt

# ---- entrypoint ----
COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

ENTRYPOINT ["/workspace/entrypoint.sh"]
