FROM python:3.9-slim

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# ---- Basic system deps ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    build-essential \
    ca-certificates \
    unzip \
 && rm -rf /var/lib/apt/lists/*

# ---- Install AWS CLI ----
RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
    unzip awscliv2.zip && \
    ./aws/install && \
    rm -rf awscliv2.zip aws/

# ---- Verify AWS CLI ----
RUN aws --version

# ---- Upgrade pip ----
RUN python -m pip install --upgrade pip setuptools wheel

# ---- Copy code ----
# NOTE: nuplan-devkit and Thesis must be present at build context root
COPY nuplan-devkit/ /workspace/nuplan-devkit/
COPY Thesis/ /workspace/Thesis/

# ---- Install PyTorch with CUDA 11.8 ----
# python:3.9-slim has no CUDA; CUDA drivers are provided by the cluster host
# via nvidia.com/gpu resource allocation — this is correct for Kubernetes GPU nodes
RUN pip install torch==2.0.1 torchvision==0.15.2 \
    --index-url https://download.pytorch.org/whl/cu118

# ---- Install NATTEN (neighbourhood attention) ----
COPY natten*.whl /workspace/
RUN pip install /workspace/natten*.whl

# ---- Install nuplan-devkit ----
RUN pip install -e /workspace/nuplan-devkit
RUN pip install -r /workspace/nuplan-devkit/requirements.txt

# ---- Install EMoE/PLUTO dependencies ----
RUN pip install -r /workspace/Thesis/requirements.txt

# ---- Create work directory for runtime data (cache, outputs) ----
RUN mkdir -p /work/cache /work/emoe_labels /work/experiments

# ---- Copy and set entrypoint ----
COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

ENTRYPOINT ["/workspace/entrypoint.sh"]
